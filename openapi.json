{
  "openapi": "3.0.3",
  "info": {
    "title": "BrasaFut API - Documentação Oficial",
    "description": "API profissional de futebol de alta performance, com suporte a campeonatos brasileiros e internacionais, dados em tempo real, estatísticas de partidas e webhooks.",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header",
        "description": "Chave de acesso obtida via /api/v1/auth/register"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/v1/auth/plans": {
      "get": {
        "summary": "Listar planos e limites de requisição",
        "tags": [
          "Autenticação & Planos"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Registrar desenvolvedor e gerar chave de API (API Key)",
        "tags": [
          "Autenticação & Planos"
        ],
        "description": "Gera instantaneamente uma chave no formato 'bf_live_...' para consumir a API.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userName": {
                    "type": "string",
                    "minLength": 2
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  }
                },
                "required": [
                  "userName",
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "userName": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "plan": {
                      "type": "string",
                      "enum": [
                        "FREE",
                        "PRO",
                        "ENTERPRISE"
                      ]
                    },
                    "rateLimitPerMinute": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "message",
                    "key",
                    "userName",
                    "email",
                    "plan",
                    "rateLimitPerMinute"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Consultar dados da chave autenticada e limites de consumo",
        "tags": [
          "Autenticação & Planos"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/billing/checkout": {
      "post": {
        "summary": "Iniciar checkout Pix para upgrade de plano",
        "tags": [
          "Billing & Monetização Pix"
        ],
        "description": "Gera um QR Code Pix dinâmico e código Copia e Cola para pagamento instantâneo e upgrade de chave da API.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "apiKey": {
                    "type": "string",
                    "description": "Chave de API a ser atualizada"
                  },
                  "targetPlan": {
                    "default": "PRO",
                    "type": "string",
                    "enum": [
                      "PRO",
                      "ENTERPRISE"
                    ]
                  }
                },
                "required": [
                  "apiKey"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paymentId": {
                      "type": "string"
                    },
                    "targetPlan": {
                      "type": "string",
                      "enum": [
                        "FREE",
                        "PRO",
                        "ENTERPRISE"
                      ]
                    },
                    "amountCents": {
                      "type": "number"
                    },
                    "amountFormatted": {
                      "type": "string"
                    },
                    "pixCopyPaste": {
                      "type": "string"
                    },
                    "pixQrCodeUrl": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string"
                    },
                    "instructions": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "paymentId",
                    "targetPlan",
                    "amountCents",
                    "amountFormatted",
                    "pixCopyPaste",
                    "pixQrCodeUrl",
                    "expiresAt",
                    "instructions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/billing/webhook": {
      "post": {
        "summary": "Webhook de confirmação de pagamento Pix",
        "tags": [
          "Billing & Monetização Pix"
        ],
        "description": "Endpoint chamado automaticamente pelo gateway de pagamento (Mercado Pago, Asaas, etc.) quando o Pix é liquidado.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event": {
                    "default": "PAYMENT_CONFIRMED",
                    "type": "string"
                  },
                  "paymentId": {
                    "type": "string"
                  }
                },
                "required": [
                  "paymentId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
