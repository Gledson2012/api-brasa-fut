    "/api/v1/webhooks/": {
      "get": {
        "summary": "Listar webhooks cadastrados",
        "tags": [
          "Webhooks"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "summary": "Cadastrar novo endpoint de Webhook",
        "tags": [
          "Webhooks"
        ],
        "description": "Registra uma URL para receber notificações instantâneas de gols, cartões e mudanças de status.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "events": {
                    "default": [
                      "ALL"
                    ],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "ALL",
                        "SCORE_UPDATE",
                        "MATCH_EVENT",
                        "STATUS_CHANGE"
