# =============================================================================
# BRASAFUT API - VARIÁVEIS DE AMBIENTE (CONFIGURAÇÃO PARA VERCEL & NEON)
# =============================================================================

# Porta do Servidor (Local)
PORT=3333
NODE_ENV=production

# -----------------------------------------------------------------------------
# BANCO DE DADOS (NEON SERVERLESS POSTGRESQL)
# -----------------------------------------------------------------------------
# Obtenha sua connection string no console da Neon (com Pooling ativado):
# https://console.neon.tech/app/org-frosty-frog-49303959/projects
DATABASE_URL="postgresql://usuario:senha@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Se conectado via Vercel Integration, essas variáveis são injetadas automaticamente:
# POSTGRES_URL="postgresql://usuario:senha@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# POSTGRES_URL_NON_POOLING="postgresql://usuario:senha@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# SEGURANÇA & ADMINISTRAÇÃO
# -----------------------------------------------------------------------------
# ADMIN_SECRET="defina-um-segredo-forte"

# Conta ENTERPRISE inicial criada pelo seed (npm run db:seed).
# Se a senha/chave não forem informadas, valores aleatórios são gerados e
# impressos uma única vez no console — nunca deixe credenciais no código.
BOOTSTRAP_ADMIN_EMAIL="admin@brasafut.local"
BOOTSTRAP_ADMIN_USER="enterprise_admin"
# BOOTSTRAP_ADMIN_PASSWORD=""
# BOOTSTRAP_ADMIN_KEY=""

# -----------------------------------------------------------------------------
# MIGRATIONS
# -----------------------------------------------------------------------------
# Pasta das migrations (padrão: ./drizzle)
# MIGRATIONS_FOLDER="drizzle"

# -----------------------------------------------------------------------------
# SEGURANÇA HTTP
# -----------------------------------------------------------------------------
# Origens liberadas no CORS (lista separada por vírgula; padrão: *)
# CORS_ORIGINS="https://app.exemplo.com,https://painel.exemplo.com"

# Aceitar a API key via query string (?api_key=) — desabilitado por segurança,
# pois URLs vazam em logs/proxies/referrers.
# ALLOW_API_KEY_QUERY_PARAM="true"

# Segredo compartilhado com o gateway de pagamentos (header 'x-pix-secret').
# Sem ele, o webhook de confirmação de Pix recusa a requisição.
# PIX_WEBHOOK_SECRET="defina-um-segredo-forte"

# Habilita simulação de Pix pago (sandbox). Em produção mantenha desabilitado:
# sem isso, apenas administradores podem aprovar cobranças manualmente.
# ALLOW_PIX_SIMULATION="true"

# -----------------------------------------------------------------------------
# CACHE & RATE LIMIT — REDIS (OPCIONAL)
# -----------------------------------------------------------------------------
# Sem Redis configurado a API usa cache e rate limit em memória do processo
# (em Serverless isso significa um contador por instância).
# REDIS_URL="rediss://default:senha@seu-redis.upstash.io:6379"
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""
# DISABLE_REDIS="true"


# -----------------------------------------------------------------------------
# NOTIFICAÇÕES PUSH FIREBASE (OPCIONAL)
# -----------------------------------------------------------------------------
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
