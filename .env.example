# --- BrasaFut API: variáveis de ambiente ---
# Copie para .env e preencha. Nunca commite .env ou chaves reais.

NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Banco
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/brasa_fut

# CORS restritivo (produção): domínios separados por vírgula
CORS_ORIGIN=https://seu-frontend.com,https://admin.seu-frontend.com

# Admin (OBRIGATÓRIO em produção)
ADMIN_SECRET=troque-por-segredo-forte-32-chars
ADMIN_API_KEY=

# Billing / Pix
BILLING_PIX_KEY=financeiro@brasafut.com.br
BILLING_PRO_CENTS=4990
BILLING_ENTERPRISE_CENTS=19900
# Segredo do webhook do PSP (MercadoPago/Asaas). Exigido via header x-webhook-secret
BILLING_WEBHOOK_SECRET=troque-por-segredo-do-psp
# Mercado Pago ao vivo (opcional; sem ele o checkout usa sandbox local)
MP_ACCESS_TOKEN=
BILLING_MP_WEBHOOK_URL=https://sua-api.com/api/v1/billing/webhook

# Rate-limit / cache distribuídos (Vercel / multi-instância)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase (prefira env a arquivo; nunca commite service-account)
FIREBASE_SERVICE_ACCOUNT=

# Seed administrativo via CLI (scripts/migrate-prod.ts) — nunca via HTTP
ENTERPRISE_EMAIL=enterprise@brasafut.com.br
ENTERPRISE_PASSWORD=troque-por-senha-forte-12-chars
ENTERPRISE_API_KEY=

# Seeds DEV locais
DEV_PASSWORD=
FREE_PASSWORD=

# Testes
TEST_API_KEY=
TEST_ENTERPRISE_KEY=
