    "/api/v1/matches/": {
      "get": {
        "summary": "Listar partidas (jogos do dia, rodada ou ao vivo)",
        "tags": [
          "Partidas"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "in": "query",
            "name": "date",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "SCHEDULED",
                "FIRST_HALF",
                "HALF_TIME",
                "SECOND_HALF",
                "EXTRA_TIME",
                "PENALTIES",
                "FINISHED",
                "POSTPONED",
                "CANCELLED"
              ]
            },
            "in": "query",
            "name": "status",
            "required": false
          },
          {
            "schema": {
              "type": "boolean"
            },
            "in": "query",
            "name": "live",
            "required": false
          },
          {
            "schema": {
              "type": "number"
            },
            "in": "query",
            "name": "seasonId",
            "required": false
          },
          {
            "schema": {
              "type": "number"
            },
            "in": "query",
            "name": "teamId",
            "required": false
