{
  "name": "api-brasa-fut",
  "version": "1.1.0",
  "description": "API profissional de futebol brasileiro e internacional com suporte a dados em tempo real",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node dist/src/db/init-cloud.js",
    "start": "node dist/src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:enterprise": "tsx scripts/seed-enterprise.ts",
    "migrate:prod": "tsx scripts/migrate-prod.ts",
    "sync:sofascore": "tsx scripts/sync-sofascore.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "test": "tsx --test tests/api.test.ts"
  },
  "keywords": [
    "football",
    "soccer",
    "api",
    "brasileirao",
    "fastify",
    "drizzle",
    "postgresql",
    "realtime"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "fastify-type-provider-zod": "^7.0.0",
    "firebase-admin": "^14.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
